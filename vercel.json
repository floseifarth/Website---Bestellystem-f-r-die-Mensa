{
    "rewrites": [
        {
            "source": "/api/supabase/:path*",
            "destination": "/api/supabase?path=:path*"
        }
    ],
    "redirects": [
        {
            "source": "/",
            "destination": "/Bestellsystem/index.html",
            "permanent": false
        },
        {
            "source": "/Bestellsystem/Anmeldestartseite.html",
            "destination": "/Bestellsystem/index.html",
            "permanent": true
        }
    ]
}